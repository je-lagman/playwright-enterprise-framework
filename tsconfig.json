{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@pages/*": ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@api/*": ["./api/*"],
      "@utils/*": ["./utils/*"],
      "@data/*": ["./test-data/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "api/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "test-data/**/*.ts",
    "playwright.config.ts"
  ]
}